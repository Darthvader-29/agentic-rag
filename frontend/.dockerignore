# frontend/.dockerignore — keep the build context lean and SECRET-FREE.
# Anything matched here never enters the image (no `.env*`, no stale node_modules).

# Dependencies (reinstalled in-image via `npm ci` from the lockfile)
node_modules
.pnp
.pnp.*

# Secrets / local env — must never be baked into an image layer
.env
.env.*
!.env.example

# Build output / caches (rebuilt in-image)
.next
out
build
.turbo
coverage

# Tests / E2E (not needed at runtime)
e2e/
playwright-report/
test-results/
*.test.ts
*.test.tsx

# Docs / CI / config noise (not needed at runtime)
*.md
.github/

# VCS / editor / OS
.git
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel
