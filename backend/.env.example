# Required (app fails fast at startup if any missing)
GOOGLE_API_KEY=
PINECONE_API_KEY=
HUGGINGFACE_TOKEN=
# Object storage (S3-compatible, via boto3). Prod uses Backblaze B2 — var names stay
# AWS_* because the client speaks the S3 API. For B2: AWS_REGION = the bucket's region
# (e.g. us-west-004), AWS_ACCESS_KEY_ID = B2 keyID, AWS_SECRET_ACCESS_KEY = B2 applicationKey.
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional
PINECONE_INDEX_NAME=rag-knowledge-base
LOG_JSON=false

# Phase 1 — storage endpoint
ENVIRONMENT=development
# Dev: leave blank → MinIO at http://localhost:9000 (docker-compose).
# Prod (Backblaze B2): https://s3.<region>.backblazeb2.com — region MUST match AWS_REGION
#   (e.g. us-west-004 → S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com).
#   Use a PRIVATE bucket (no credit card needed); every read is authenticated.
S3_ENDPOINT_URL=

# Dev MinIO defaults (must match docker-compose). In prod use your B2 keyID/applicationKey.
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=rag-documents

# Phase 2 — PostgreSQL (NeonDB)
# Use postgresql:// or postgresql+asyncpg://; the app auto-adds asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://user:pass@host/proddb?sslmode=require
# Used by repository tests only (set in CI / local dev; leave blank to skip DB tests)
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@host/testdb?sslmode=require

# Phase 3 — Auth + Encryption + CORS
# JWT signing secret — keep this strong and secret, never commit the real value
JWT_SECRET=
# Optional JWT tuning (defaults: 15 min access, 7 day refresh, HS256 algo)
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# Fernet master key for BYOK LLM key encryption.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit the real value. Rotate via scripts/rotate_llm_keys.py on compromise.
LLM_KEY_ENCRYPTION_KEY=

# Comma-separated JSON list of allowed CORS origins (no wildcards with credentials).
# Example: '["http://localhost:3000","https://your-frontend.vercel.app"]'
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Phase 5 — Redis, Celery broker, rate limiting
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=          # optional; defaults to REDIS_URL
# RATE_LIMIT_STORAGE_URI=     # optional; defaults to REDIS_URL (tests use memory://)
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=120/minute
